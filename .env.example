# Template variabili d'ambiente — copia in .env.local e compila.
# Vedi .env.local per la descrizione di ogni variabile.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INTERVALS_OAUTH_CLIENT_ID=
INTERVALS_OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Chiave API Groq (console.groq.com, tier gratuito) — abilita i commenti AI.
# Se assente l'app funziona normalmente, con i bottoni AI disabilitati.
GROQ_API_KEY=
# Allowlist beta (Passo 3): email autorizzate a registrarsi, separate da
# virgola (es. "io@example.com,amico@example.com"). Se vuota o assente,
# NESSUNA registrazione viene accettata (fail closed).
BETA_ALLOWED_EMAILS=
